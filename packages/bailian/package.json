{
  "name": "@modelbay/bailian",
  "version": "0.1.0",
  "description": "Alibaba Bailian / DashScope adapter",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
