{
  "name": "@modelbay/cli",
  "version": "0.2.0",
  "description": "Command-line tool for Volcengine Ark, Alibaba Bailian, MiniMax, Doubao Speech and OpenAI: generate images, video, speech and music or chat from the terminal",
  "keywords": [
    "cli",
    "command-line",
    "volcengine",
    "ark",
    "doubao",
    "seedream",
    "seedance",
    "bailian",
    "dashscope",
    "qwen",
    "wan",
    "minimax",
    "openai",
    "ai",
    "llm",
    "image-generation",
    "video-generation",
    "text-to-speech",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoobnn/modelbay.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/hoobnn/modelbay/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/hoobnn/modelbay/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "modelbay": "./dist/bin/modelbay.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "vp pack"
  },
  "peerDependencies": {
    "zod": "^4.6"
  },
  "dependencies": {
    "modelbay": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "zod": "catalog:",
    "@modelbay/core": "workspace:*"
  }
}
