  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoobnn/modelbay.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/hoobnn/modelbay/tree/main/packages/shared#readme",
  "bugs": {
    "url": "https://github.com/hoobnn/modelbay/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
