      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "vp pack"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.106",
