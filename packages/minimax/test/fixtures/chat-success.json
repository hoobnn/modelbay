  "response": {
    "status": 200,
    "body": {
      "base_resp": { "status_code": 0, "status_msg": "success" },
      "choices": [{ "message": { "content": "你好！" }, "finish_reason": "stop" }],
      "usage": { "prompt_tokens": 5, "completion_tokens": 3 },
      "id": "req-chat-1"
    }
  }
