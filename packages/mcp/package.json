    "ai",
    "llm",
    "image-generation",
    "video-generation",
    "text-to-speech",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoobnn/modelbay.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/hoobnn/modelbay/tree/main/packages/mcp#readme",
