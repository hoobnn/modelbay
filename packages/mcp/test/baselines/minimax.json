              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Frame"
        },
        "reference_images": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Images"
        },
        "reference_videos": {
          "anyOf": [
