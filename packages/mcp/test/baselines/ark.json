            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration"
        },
        "audio": {
          "default": true,
          "title": "Audio",
          "type": "boolean"
        },
        "watermark": {
          "default": false,
