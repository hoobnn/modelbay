  {
    "name": "get_job",
    "description": "查任务进度和结果，job_id 或 task_id 二选一（都给时须属于同一任务）。\n视频还在生成时查询方舟一次（wait 1–90 秒可轮询），完成即下载到原输出目录；已结束的任务只读本地记录。\n只给 task_id 且本地没有记录（如别处提交的 Seedance 任务）时，新建本地记录再查询。不会重新提交生成。\n返回 job_state（running/delivered/failed/download_failed 等）、completed、files、usage；ok=false 表示查询或交付失败。\n",
    "inputSchema": {
      "properties": {
        "job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "wait": {
          "default": 0,
          "maximum": 90,
          "minimum": 0,
          "title": "Wait",
          "type": "integer"
        },
        "include_response": {
          "default": false,
          "description": "返回原始响应，默认false",
          "title": "Include Response",
          "type": "boolean"
        }
      },
      "title": "get_jobArguments",
      "type": "object"
    },
    "outputSchema": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
