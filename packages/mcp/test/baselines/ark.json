[
  {
    "name": "chat",
    "description": "调用方舟语言/多模态模型，pro=豆包Seed 2.1 pro；其他方舟模型（含目录中的 DeepSeek）传完整ID。不同平台的型号与权限不可通用。\nimages支持本地图片或URL，videos为公网URL。history用Chat消息格式，工具不保存对话。\nweb_search=true或传previous_response_id时使用Responses API，保留sources和response_id；否则走Chat API。\nthinking=true/false映射enabled/disabled；最新API不再列出auto。json_mode要求提示词明确JSON结构；parameters透传模型支持的高级字段。\nparameters.prompt_cache_key为可选缓存路由标识，Chat与Responses均支持；省略不关闭隐式缓存，设置也不保证命中。\n同一Endpoint和模型下连续上下文复用不可读内部Session ID，不同用户或并行会话使用不同值；不要传个人信息、凭证或prompt原文。\n官方建议单key总流量低于每分钟15个请求；这是路由建议而非硬限流，扩缩容等仍可能重新路由。\n返回content、reasoning、usage；include_response=true可取完整response。按token与搜索调用计费，模型和搜索服务须已开通；尚未完成云端验证。\n",
    "inputSchema": {
      "properties": {
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "model": {
          "default": "pro",
          "title": "Model",
          "type": "string"
        },
        "system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System"
        },
        "history": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History"
        },
        "images": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Images"
        },
        "videos": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Videos"
        },
        "thinking": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        },
        "max_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "json_mode": {
          "default": false,
          "title": "Json Mode",
          "type": "boolean"
        },
        "web_search": {
          "default": false,
          "title": "Web Search",
          "type": "boolean"
        },
        "previous_response_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Response Id"
        },
        "parameters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters"
        },
        "include_response": {
          "default": false,
          "description": "返回原始响应，默认false",
          "title": "Include Response",
          "type": "boolean"
        }
      },
      "required": ["prompt"],
      "title": "chatArguments",
      "type": "object"
    },
    "outputSchema": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
