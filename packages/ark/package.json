{
  "name": "@modelbay/ark",
  "version": "0.1.0",
  "description": "Volcengine Ark adapter (pay-as-you-go and plan channels)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./tos": {
      "types": "./dist/node/index.d.mts",
      "default": "./dist/node/index.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "vp pack"
  },
  "peerDependencies": {
    "@volcengine/tos-sdk": "^2.9.1",
    "ws": "^8.18.0",
    "zod": "^4.6"
  },
  "peerDependenciesMeta": {
    "@volcengine/tos-sdk": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelbay/core": "workspace:*",
    "@modelbay/doubao-speech": "workspace:*",
    "@modelbay/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@volcengine/tos-sdk": "^2.9.1",
    "typescript": "^7.0.2",
    "ws": "^8.22.1",
    "zod": "catalog:"
  }
}
