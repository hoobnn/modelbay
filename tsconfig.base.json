{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@modelbay/*/node": ["./packages/*/src/node/index.ts"],
      "@modelbay/*": ["./packages/*/src/index.ts"],
      "modelbay/node": ["./packages/modelbay/src/node.ts"],
      "modelbay": ["./packages/modelbay/src/index.ts"]
    }
  }
}
