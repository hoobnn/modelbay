[
 {
  "name": "clone_voice",
  "description": "声音复刻：用一段录音注册或重新训练音色。speaker_id 是控制台已分配的 S_ 音色 ID（用自定义 ID 时传\nspeaker_id='custom_speaker_id' 并填 custom_speaker_id）。audio_file：本地录音（wav/mp3/ogg/m4a/aac/pcm，10MB 内），\n清晰单人、少噪音。text：录音对应文本，服务会比对，差异过大会失败。language：zh（默认）、en、ja、es、de、fr、ko、\nit、ru、pt、pt-br 等。demo_text：试听文本 4–300 字。parameters：官方请求其余字段（如 extra_params、model_type），深度合并。\n会消耗训练次数，不自动重试。之后用 get_voice 查训练状态，合成时把 speaker_id 作为 text_to_speech 的 voice；复刻的音色只能用于豆包合成。\n录音技巧见 get_speech_usage_examples(product='voice')。\n",
  "inputSchema": {
   "properties": {
    "speaker_id": {
     "title": "Speaker Id",
     "type": "string"
    },
    "audio_file": {
     "title": "Audio File",
     "type": "string"
    },
    "text": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Text"
    },
    "language": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Language"
    },
    "demo_text": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Demo Text"
    },
    "custom_speaker_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Custom Speaker Id"
    },
    "parameters": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Parameters"
    }
   },
   "required": [
    "speaker_id",
    "audio_file"
   ],
   "title": "clone_voiceArguments",
   "type": "object"
  },
  "outputSchema": {
   "type": "object",
   "required": [
    "ok"
   ],
   "properties": {
    "ok": {
     "type": "boolean"
    }
   },
   "additionalProperties": true
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "idempotentHint": false,
   "openWorldHint": true
  }
 },
